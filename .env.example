# Vertex AI Configuration (as per Anthropic SDK docs)
# Required for AnthropicVertex client
ANTHROPIC_VERTEX_PROJECT_ID=your-project-id
CLOUD_ML_REGION=us-east5

# Authentication: Uses Google Cloud Application Default Credentials
# Method 1: gcloud auth (recommended for development)
#   gcloud auth application-default login
#
# Method 2: Service account (for containers/production)
#   export GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# Method 3: Automatic (when running on GCP - Compute Engine, Cloud Run, etc.)

# Optional: Direct Anthropic API instead of VertexAI
# ANTHROPIC_API_KEY=your-api-key-here

# Redis Configuration
# Use 'redis' (service name) when running in containers
# Use 'localhost' only for local development outside containers
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Jira Configuration
JIRA_BASE_URL=https://yoursite.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_CLOUD_ID=your-cloud-id
JIRA_API_TOKEN=your-jira-token
JIRA_PROJECT_KEY=ANSIBLE

# GitHub/GitLab Configuration
GITHUB_TOKEN=ghp_your_token_here
GITLAB_TOKEN=glpat_your_token_here
GIT_PLATFORM=github  # or gitlab
GIT_REPO_OWNER=ansible-collections
GIT_REPO_NAME=amazon.aws

# Agent Configuration
AGENT_MODEL=claude-opus-4-7
AGENT_MAX_TOKENS=64000
AGENT_EFFORT=xhigh
YOLO_MODE=true  # Autonomous operation without human approval

# Dashboard Configuration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
